APP_NAME=PatchWise AI
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

POSTGRES_USER=patchwise
POSTGRES_PASSWORD=patchwisepassword
POSTGRES_DB=patchwise
DATABASE_URL=postgresql+psycopg://patchwise:patchwisepassword@postgres:5432/patchwise

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
JWT_SECRET_KEY=replace_with_secure_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=60

API_PORT=8000
FRONTEND_PORT=5173